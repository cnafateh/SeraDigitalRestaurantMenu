{
  "name": "sera-menu-studio",
  "version": "2.0.0",
  "description": "A self-hosted, multi-template digital menu platform with an ASP.NET Core API and PostgreSQL.",
  "keywords": [
    "restaurant-menu",
    "react",
    "aspnetcore",
    "postgresql",
    "typescript",
    "docker"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "format:check": "prettier --check src",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.9.8",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
